{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin/css/:path*", "destination": "/admin/css/:path*" },
    { "source": "/admin/js/:path*", "destination": "/admin/js/:path*" },
    { "source": "/admin/images/:path*", "destination": "/admin/images/:path*" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/all-sports/:path*", "destination": "/home" },
    { "source": "/all-sports", "destination": "/home" },
    { "source": "/sports/:path*", "destination": "/home" },
    { "source": "/sports-book/:path*", "destination": "/home" },
    { "source": "/game-details/:path*", "destination": "/game-details" },
    { "source": "/game-detail/:path*", "destination": "/game-details" },
    { "source": "/gamedetails/:path*", "destination": "/game-details" },
    { "source": "/cricketv/:path*", "destination": "/game-details" },
    { "source": "/virtual-cricket/:path*", "destination": "/game-details" },
    { "source": "/tp-virtual-cricket/:path*", "destination": "/game-details" },
    { "source": "/casino-list/:path*", "destination": "/casino" },
    { "source": "/casino-list", "destination": "/casino" },
    { "source": "/live-casino-list/:path*", "destination": "/casino" },
    { "source": "/live-casino-list", "destination": "/casino" },
    { "source": "/slot-list/:path*", "destination": "/casino" },
    { "source": "/slot-list", "destination": "/casino" },
    { "source": "/fantasy-list", "destination": "/casino" },
    { "source": "/casino/:path*", "destination": "/casino" },
    { "source": "/aviator-list", "destination": "/aviator" },
    { "source": "/withdraw-statement", "destination": "/account-statement" },
    { "source": "/deposit-statement", "destination": "/account-statement" },
    { "source": "/activity-log", "destination": "/account-statement" },
    { "source": "/live-casino-bets", "destination": "/current-bet" },
    { "source": "/casino-results/:path*", "destination": "/casino-results" }
  ]
}
